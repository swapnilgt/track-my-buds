# Local development secrets for the Docker Compose stack.
#
# Copy to `.env` (which is git-ignored) and adjust if needed:
#   cp .env.example .env
#
# The compose file has these same values baked in as defaults, so the stack
# runs without a .env too. Real secrets NEVER live here — preprod/prod inject
# them from a secrets manager.

# Postgres superuser (container admin).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=localdev

# Shared password for the per-service database roles created at first startup.
APP_DB_PASSWORD=localdev

# MinIO root credentials (also used to log in to the console UI on :9001).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Grafana admin login (UI on :3000).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
